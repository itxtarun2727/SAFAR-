# SAFAR — Smart AICTE FDR Automation & Registry
# Environment Variables Configuration Template
# Copy this file to .env and configure for your local or cloud deployment.

APP_NAME=SAFAR Portal
ENV=development

# Database Configuration (PostgreSQL 16)
# In production (DEMO_MODE=false), DATABASE_URL is strictly required.
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:<db_port>/<db_name>

# Security & JWT Authentication
# In production (DEMO_MODE=false), JWT_SECRET is strictly required.
JWT_SECRET=<generate-at-least-32-chars-random-secret-key>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demonstration & Evaluation Mode (enables /clock and /audit demo mutations)
# Set to 'false' in production.
DEMO_MODE=true

# Allowed CORS Origins (comma-separated list for backend API)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://safar-frontend.vercel.app

# Pluggable Storage Backend (database | s3)
# 'database' stores document bytea directly in PostgreSQL (ideal for Render ephemeral containers)
# 's3' stores in AWS S3 or MinIO
STORAGE_BACKEND=database
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=

# Demo Clock Override (leave empty for real UTC system time)
DEMO_CLOCK_OVERRIDE=
