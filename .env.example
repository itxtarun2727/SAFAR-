# SAFAR Portal — Environment Variables
# Copy this file to .env and configure for local runtime

APP_NAME=SAFAR Portal
ENV=development

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://safar:safar_secure_password@localhost:5432/safar_db

# Security & JWT Authentication
JWT_SECRET=safar-super-secret-key-min-32-chars-long-change-in-prod!!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo Time-Travel Clock (leave empty for real UTC system time)
# Set ISO format date to fast forward, e.g. "2027-03-15T00:00:00Z"
DEMO_CLOCK_OVERRIDE=

# Simulation Flags
BANK_SIMULATOR_ENABLED=true

# Frontend URL
VITE_API_URL=http://localhost:8000
