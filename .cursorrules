│   └── Dockerfile
│
└── frontend/                  # React 18 + Vite + Tailwind CSS (.jsx / .js)
    ├── package.json
    ├── vite.config.js
    ├── tailwind.config.js
    ├── index.html
    └── src/
        ├── main.jsx           # App entrypoint
        ├── App.jsx            # Shell with top bar, persistent simulation banner & tabs
        ├── index.css          # Tailwind CSS directives
        ├── api.js             # Centralized typed API client
        ├── AuthContext.jsx    # Current user, demo persona switcher & token storage
        └── components/        # 9 Core components + StatusBadge.jsx
            ├── StatusBadge.jsx
            ├── TwoColumnTrustView.jsx
            ├── QueueTable.jsx
            ├── StatCard.jsx
            ├── Timeline.jsx
            ├── AlertList.jsx
            ├── LineageChain.jsx
            ├── ReleaseStepper.jsx
            ├── AuditChainViewer.jsx
            └── DemoClockChip.jsx
```

